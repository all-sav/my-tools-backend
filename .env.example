HTTP_PORT=:8020
WS_PORT=:8021

# Адрес сервака для установки allowed origins для websocket
APP_URL=https://my-domain.com

GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_ACCESS_TOKEN=
GITLAB_WEBHOOK_TOKEN=

BACKEND_PROJECT_ID=21
FRONTEND_PROJECT_ID=22
BACKEND_STAND_BRANCH=my-backend-branch-on-server
FRONTEND_STAND_BRANCH=my-frontend-branch-on-server
CI_MAIN_BRANCH=my-branch-with-addons
REQUIRED_PREFIX=prefix-for-branches/TASK-
PREFIX=prefix-for-branches/
CI_PREFIX=CI-

OVER_PROXY=true
SSL_CERT_PEM=./localhost+2.pem
SSL_KEY_PEM=./localhost+2-key.pem

# Аутентификация
AUTH_USERNAME=root
AUTH_PASSWORD=punk

TOKEN_TTL=24h
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
